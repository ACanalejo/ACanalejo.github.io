---
layout: default
---
<div class="post">
  <header class="post-header">
    <h1 class="post-title">
      Curriculum Vitae
    </h1>
  </header>

  <article>
    <div class="cv">
      {% for entry in site.data.cv %}
        {% if entry.type == 'pdf' %}
          {% for content in entry.contents %}
            <div class="card mt-3 p-3">
              <a
                href="{{ content.file }}"
                target="_blank"
                rel="noopener noreferrer"
                class="btn btn-primary"
              >
                <i class="fa-solid fa-file-pdf"></i> Download PDF
              </a>
              <embed
                src="{{ content.file }}"
                type="application/pdf"
                class="mt-3"
                style="width: 100%; height: 1200px; border: 1px solid var(--global-divider-color, #ddd);"
              />
            </div>
          {% endfor %}
        {% endif %}
      {% endfor %}
    </div>
  </article>
</div>
